{
  "expo": {
    "name": "Be A Number",
    "slug": "beanumber",
    "scheme": "beanumber",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "baseUrl": "/app-preview"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.beanumber.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:www.beanumber.org",
        "applinks:beanumber.org"
      ]
    },
    "android": {
      "package": "org.beanumber.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFF8F0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://www.beanumber.org",
      "router": {}
    }
  }
}