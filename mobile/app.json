{
  "expo": {
    "name": "Be A Number",
    "slug": "be-a-number",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#D4A843",
    "scheme": "beanumber",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.beanumber.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:beanumber.org",
        "applinks:www.beanumber.org"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Optional — used to scan shirt QR codes so the app can jump straight to the reveal moment. Nothing else.",
        "NSPhotoLibraryUsageDescription": "Save your reveal moments and letters to your camera roll.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.beanumber.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#fafafa",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "beanumber.org",
              "pathPrefix": "/meet"
            },
            {
              "scheme": "https",
              "host": "beanumber.org",
              "pathPrefix": "/children"
            },
            {
              "scheme": "https",
              "host": "beanumber.org",
              "pathPrefix": "/newsletter"
            },
            {
              "scheme": "https",
              "host": "beanumber.org",
              "pathPrefix": "/campus"
            },
            {
              "scheme": "https",
              "host": "beanumber.org",
              "pathPrefix": "/me"
            },
            {
              "scheme": "https",
              "host": "www.beanumber.org",
              "pathPrefix": "/meet"
            },
            {
              "scheme": "https",
              "host": "www.beanumber.org",
              "pathPrefix": "/children"
            },
            {
              "scheme": "https",
              "host": "www.beanumber.org",
              "pathPrefix": "/newsletter"
            },
            {
              "scheme": "https",
              "host": "www.beanumber.org",
              "pathPrefix": "/campus"
            },
            {
              "scheme": "https",
              "host": "www.beanumber.org",
              "pathPrefix": "/me"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "beanumber"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fafafa",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0d0d0d"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4A843"
        }
      ],
      "expo-video"
    ]
  }
}
