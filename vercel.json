{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "beanumber.org"
        }
      ],
      "destination": "https://www.beanumber.org/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/newsletter",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/drip",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/push-drain",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/sunday-batch",
      "schedule": "0 13 * * 0"
    }
  ]
}
